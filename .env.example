# ------------------------------------------------------------------
# Amazon Connect - Communications widget (webchat)
# ------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha com os valores do
# snippet gerado em:
#   Connect admin -> Channels -> Communication widgets -> seu widget
#
# No snippet, os valores aparecem assim:
#
#   (function(w, d, x, id){ s.src='<SCRIPT_URL>'; ... })(window, document, 'amazon_connect', '<WIDGET_ID>');
#   amazon_connect('snippetId', '<SNIPPET_ID>');
# ------------------------------------------------------------------

# Liga o carregamento do widget (true | false)
VITE_CONNECT_CHAT_ENABLED=false

# 4o argumento do snippet: identificador curto do widget
VITE_CONNECT_WIDGET_ID=

# String longa passada em amazon_connect('snippetId', '...')
VITE_CONNECT_SNIPPET_ID=

# URL do script do widget (no snippet: s.src='...')
# Pode ser CloudFront ou {instancia}.my.connect.aws/connectwidget/...
VITE_CONNECT_SCRIPT_URL=
